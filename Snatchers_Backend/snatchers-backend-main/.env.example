# Database
MONGO_URI=mongodb://localhost:27017/snatchers

# AWS Cognito
COGNITO_USER_POOL_ID=your_user_pool_id
COGNITO_CLIENT_ID=your_client_id
COGNITO_CLIENT_SECRET=your_client_secret
COGNITO_REGION=us-east-1
COGNITO_REDIRECT_URI=http://localhost:5000/callback

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Session Configuration
SESSION_SECRET=your_session_secret
SESSION_COOKIE_DOMAIN=localhost
SESSION_SAME_SITE=lax

# Payment Gateways
# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENVIRONMENT=sandbox

# Email Services
# SMTP (fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Mailgun
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain

# From Email
FROM_EMAIL=noreply@snatchers.in
TEST_EMAIL=test@example.com

# Analytics Integration
# Google Analytics 4
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_API_SECRET=your_ga_api_secret

# Facebook Pixel
FB_PIXEL_ID=your_facebook_pixel_id
FB_ACCESS_TOKEN=your_facebook_access_token

# Google Ads
GOOGLE_ADS_CONVERSION_ID=your_conversion_id
GOOGLE_ADS_CONVERSION_LABEL=your_conversion_label

# Elasticsearch (for search)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elasticsearch_password

# Other Services
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Development/Production
NODE_ENV=development
PORT=5000
DEBUG_ALLOW_ALL_CORS=false
FAIL_FAST_ON_MISSING_REDIRECT=false

# Production Monitoring and Logging
MONITORING_WEBHOOK_URL=https://your-monitoring-service.com/webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
ALERT_EMAIL=alerts@your-domain.com
ERROR_EMAIL_ALERTS=true
LOG_SERVICE_URL=https://your-log-service.com/api/logs

# Error Tracking Services (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
BUGSNAG_API_KEY=your_bugsnag_api_key
ROLLBAR_ACCESS_TOKEN=your_rollbar_access_token
ERROR_WEBHOOK_URL=https://your-error-tracking-webhook.com

# Deployment Configuration
DEPLOYMENT_TIMESTAMP=2024-01-01T00:00:00Z
DEPLOYMENT_WEBHOOK_URL=https://your-deployment-webhook.com

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# SSL/TLS Configuration
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/key.pem

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# Security Configuration
HELMET_CSP_ENABLED=true
CORS_ALLOWED_ORIGINS=https://snatchers.in,https://www.snatchers.in
TRUST_PROXY=true

# Performance Configuration
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6
STATIC_CACHE_MAX_AGE=31536000

# Database Configuration
MONGO_MAX_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=us-east-1