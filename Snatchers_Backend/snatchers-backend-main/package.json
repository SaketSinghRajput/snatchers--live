{
  "name": "snatchers-backend",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "cross-env NODE_ENV=development nodemon server.js --ignore tests/ --ignore logs/",
    "validate-config": "node ./bin/validate-config.js",
    "migrate:add-offerPrice": "node ./bin/migrate-add-offerPrice.js",
    "migrate:add-passwords": "node ./bin/migrate-add-passwords.js",
    "migrate:enhanced-models": "node ./bin/migrate-enhanced-models.js",
    "migrate:seo-slugs": "node ./bin/migrate-seo-slugs.js",
    "cleanup:data-retention": "node ./bin/data-retention-cleanup.js",
    "cleanup:data-retention-dry": "DRY_RUN=true node ./bin/data-retention-cleanup.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:unit": "jest --testPathPattern=unit",
    "test:performance": "artillery run tests/performance/load-test.yml",
    "deploy": "./scripts/deploy.sh",
    "deploy:dev": "./scripts/deploy.sh development",
    "deploy:staging": "./scripts/deploy.sh staging",
    "deploy:prod": "./scripts/deploy.sh production",
    "setup:production": "sudo ./scripts/production-setup.sh",
    "backup": "./scripts/backup.js",
    "backup:restore": "node ./scripts/backup.js --restore",
    "logs:view": "tail -f logs/combined.log",
    "logs:error": "tail -f logs/error.log",
    "logs:clean": "node -e \"require('./services/LoggingService.js').default.cleanOldLogs(30)\"",
    "monitoring:test": "curl -f http://localhost:5000/health",
    "monitoring:dashboard": "open http://localhost:3001",
    "validate:production": "node ./scripts/validate-production.js",
    "prestart": "npm run validate:production",
    "docker:build": "docker build -t snatchers-backend .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f app",
    "docker:monitoring": "docker-compose --profile monitoring up -d",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "logs": "tail -f logs/combined.log",
    "health": "curl -f http://localhost:5000/health || echo 'Health check failed'",
    "clean": "rm -rf node_modules package-lock.json",
    "restore": "node ./scripts/restore.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankmay0/snatchers-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ankmay0/snatchers-backend/issues"
  },
  "homepage": "https://github.com/ankmay0/snatchers-backend#readme",
  "dependencies": {
    "@elastic/elasticsearch": "^9.1.1",
    "@sendgrid/mail": "^8.1.0",
    "aws-jwt-verify": "^3.1.0",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "connect-mongo": "^4.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.1",
    "express-validator": "^7.0.1",
    "fuse.js": "^7.1.0",
    "google-auth-library": "^8.8.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mailgun.js": "^10.2.1",
    "mongoose": "^8.15.1",
    "multer": "^2.0.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.8",
    "openid-client": "^5.7.0",
    "razorpay": "^2.9.6",
    "sanitize-html": "^2.11.0",
    "sitemap": "^8.0.1",
    "slugify": "^1.6.6",
    "snatchers-monorepo-root": "file:../..",
    "socket.io": "^4.7.4",
    "stripe": "^14.9.0",
    "web-push": "^3.6.7",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "artillery": "^2.0.0",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.3",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "routes/**/*.js",
      "services/**/*.js",
      "models/**/*.js",
      "controllers/**/*.js",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
