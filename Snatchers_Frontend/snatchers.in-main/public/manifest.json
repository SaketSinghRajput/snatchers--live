{
  "name": "Snatchers - Premium E-commerce Platform",
  "short_name": "Snatchers",
  "description": "Discover premium jewelry, fashion, and lifestyle products with Snatchers - your ultimate shopping destination.",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "theme_color": "#000000",
  "background_color": "#ffffff",
  "scope": "/",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["shopping", "lifestyle", "business"],
  "screenshots": [
    {
      "src": "/screenshots/desktop-home.png",
      "sizes": "1280x720",
      "type": "image/png",
      "platform": "wide",
      "label": "Home page showcasing featured products"
    },
    {
      "src": "/screenshots/mobile-shop.png", 
      "sizes": "390x844",
      "type": "image/png",
      "platform": "narrow",
      "label": "Shop page with product grid"
    },
    {
      "src": "/screenshots/mobile-product.png",
      "sizes": "390x844", 
      "type": "image/png",
      "platform": "narrow",
      "label": "Product detail page with gallery"
    }
  ],
  "icons": [
    {
      "src": "/favicon.ico",
      "sizes": "64x64 32x32 24x24 16x16",
      "type": "image/x-icon"
    },
    {
      "src": "/logo192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "/logo512.png",
      "type": "image/png", 
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "/logo192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "maskable"
    },
    {
      "src": "/logo512.png",
      "type": "image/png",
      "sizes": "512x512", 
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Shop Now",
      "short_name": "Shop",
      "description": "Browse our product catalog",
      "url": "/shop",
      "icons": [
        {
          "src": "/icons/shop-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "My Cart",
      "short_name": "Cart", 
      "description": "View items in your cart",
      "url": "/cart",
      "icons": [
        {
          "src": "/icons/cart-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "My Profile",
      "short_name": "Profile",
      "description": "Manage your account and orders", 
      "url": "/profile",
      "icons": [
        {
          "src": "/icons/profile-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Wishlist",
      "short_name": "Wishlist",
      "description": "View your saved items",
      "url": "/wishlist", 
      "icons": [
        {
          "src": "/icons/wishlist-96.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.snatchers.app",
      "id": "com.snatchers.app"
    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/snatchers/id123456789"
    }
  ],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "preferred",
  "protocol_handlers": [
    {
      "protocol": "web+snatchers",
      "url": "/product/%s"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text", 
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": ["image/*"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/import",
      "accept": {
        "text/csv": [".csv"],
        "application/json": [".json"]
      }
    }
  ]
}